<%- include('../partials/head', { title: '標籤查詢' }) %>
<h1>標籤查詢</h1>
<form class="search" method="get" action="/admin/labels">
  <input name="code" value="<%= query %>" placeholder="貼上 16 碼變動碼或整串 QR 網址" maxlength="200" class="mono" required>
  <button type="submit">查詢</button>
</form>

<% if (query && !label) { %>
<p class="error">查無此變動碼。請確認是 16 碼變動碼，或是完整的 QR 網址。</p>
<% } %>

<% if (label) { %>
<% const voided = label.status === 'void' || label.batch_status === 'void'; %>
<dl class="kv">
  <dt>產品</dt><dd><span class="mono"><%= label.product_id %></span> <%= label.product_name %></dd>
  <dt>批次 / 流水號</dt><dd>#<%= label.batch_id %> / <%= label.sn %></dd>
  <dt>qrcodedata</dt><dd class="mono"><%= qrData %></dd>
  <dt>狀態</dt>
  <dd>
    <% if (label.status === 'void') { %>標籤已作廢
    <% } else if (label.batch_status === 'void') { %>批次已作廢
    <% } else { %>啟用<% } %>
  </dd>
  <dt>掃描</dt><dd><%= label.scan_count %> 次，首次 <%= fmt(label.first_scan_at) || '—' %></dd>
  <dt>驗證成功</dt><dd><%= label.verify_count %> 次，首次 <%= fmt(label.first_verify_at) || '—' %></dd>
  <dt>驗證失敗</dt>
  <dd>
    <%= label.fail_count %> 次
    <% if (label.fail_count >= maxFails) { %><strong class="error">（已鎖定，消費者無法驗證）</strong><% } %>
  </dd>
</dl>

<div class="label-actions">
  <% if (label.fail_count > 0) { %>
  <details class="confirm restore">
    <summary>解鎖（失敗次數歸零）</summary>
    <form method="post" action="/admin/labels/<%= label.id %>/unlock">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="hint">請先確認對方是真正的持有人，再解鎖。</p>
      <button type="submit">確定解鎖</button>
    </form>
  </details>
  <% } %>

  <% if (label.status === 'void') { %>
  <details class="confirm restore">
    <summary>恢復啟用此標籤</summary>
    <form method="post" action="/admin/labels/<%= label.id %>/restore">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">確定恢復</button>
    </form>
  </details>
  <% } else if (!voided) { %>
  <details class="confirm">
    <summary>作廢此標籤</summary>
    <form method="post" action="/admin/labels/<%= label.id %>/void">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="danger">確定作廢</button>
    </form>
  </details>
  <% } %>
  <% if (label.batch_status === 'void') { %>
  <p class="hint">整個批次 #<%= label.batch_id %> 已作廢，要恢復請到<a href="/admin/batches">批次</a>頁。</p>
  <% } %>
</div>

<h2>事件紀錄（<%= events.length %>）</h2>
<table>
  <thead><tr><th>時間</th><th>類型</th><th>IP</th><th>User-Agent</th></tr></thead>
  <tbody>
  <% const typeNames = {
       scan: '掃描', verify_ok: '驗證成功', verify_fail: '驗證失敗', not_found: '產品碼不符',
       admin_void: '🔧 後台作廢', admin_restore: '🔧 後台恢復', admin_unlock: '🔧 後台解鎖',
     }; %>
  <% for (const e of events) { %>
    <tr>
      <td><%= fmt(e.created_at) %></td>
      <td><%= typeNames[e.type] || e.type %></td>
      <td class="mono" title="雜湊 <%= e.ip_hash || '' %>">
        <% if (e.ip) { %><%= e.ip %>
        <% } else if (e.ip_hash) { %><span class="hint">僅有雜湊 <%= e.ip_hash.slice(0, 12) %></span><% } %>
      </td>
      <td class="ua"><%= e.user_agent || '' %></td>
    </tr>
  <% } %>
  <% if (!events.length) { %><tr><td colspan="4" class="empty">尚無紀錄</td></tr><% } %>
  </tbody>
</table>
<% } %>
<%- include('../partials/foot') %>
