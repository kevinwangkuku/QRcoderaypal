<%- include('../partials/head', { title: '建立批次' }) %>
<h1>建立批次</h1>
<% if (errors.length) { %>
<ul class="error"><% for (const e of errors) { %><li><%= e %></li><% } %></ul>
<% } %>
<% if (!products.length) { %>
<p>請先<a href="/admin/products/new">新增產品</a>。</p>
<% } else { %>
<form class="form" method="post" action="/admin/batches/preview">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>產品
    <select name="product_id" required>
      <option value="">請選擇</option>
      <% for (const p of products) { %>
      <option value="<%= p.id %>" <%= p.id === form.productId ? 'selected' : '' %>><%= p.id %>　<%= p.name %></option>
      <% } %>
    </select>
  </label>
  <label>數量（上限 100,000）
    <input name="quantity" type="number" min="1" max="100000" step="1" value="<%= form.quantity %>" required>
  </label>
  <label>備註
    <input name="note" value="<%= form.note %>" maxlength="500">
  </label>
  <div class="actions"><button type="submit">預覽</button></div>
</form>
<% } %>
<%- include('../partials/foot') %>
