PORT=3000
# 暫定網域，正式網域確定後替換；必須全大寫、結尾不加斜線。
# 路徑固定佔 24 字元，M 級糾錯 Version 2 最多 38 字元，所以 BASE_URL 最多 14 字元。
BASE_URL=HTTPS://Q.CO
DB_PATH=./data/app.db
# 後台上傳的產品圖片；備份時要連同資料庫一起備份
UPLOAD_DIR=./data/uploads
ADMIN_USER=admin
# 至少 12 字元；保留範例值會拒絕啟動
ADMIN_PASS=請改成強密碼
# 本機開發沒有 HTTPS 時可設為 false；正式環境務必維持 true
ADMIN_REQUIRE_HTTPS=true
# IP 雜湊用的鹽，至少 16 字元；可用 node -e "console.log(require('crypto').randomBytes(24).toString('hex'))" 產生
IP_HASH_SALT=請改成隨機字串
# Express trust proxy；反向代理在同一台機器上時用 loopback
TRUST_PROXY=loopback
# 消費者頁面的聯絡資訊（重複查詢、查無此標籤、鎖定等畫面會顯示）；留空的欄位不顯示
# CONTACT_NAME 是公司或品牌名稱，會顯示成「請聯繫 {名稱} 協助確認」；留空則顯示「請聯繫我們協助確認」
CONTACT_NAME=
CONTACT_PHONE=
CONTACT_EMAIL=
# 例如 LINE 官方帳號或官網客服頁，需以 https:// 開頭
CONTACT_URL=
CONTACT_URL_LABEL=LINE 客服
QR_EC_LEVEL=M
QR_MAX_VERSION=2
QR_MARGIN=2
TZ=Asia/Taipei
